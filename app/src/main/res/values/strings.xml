    <string name="open_system_settings_home">Open Settings home</string>
    <string name="notification_access_manual">Search Settings for “Notification access” or “Device &amp; app notifications”, then select LyricsBridge.</string>
    <string name="notification_access_hyperos">On HyperOS, search Settings for “Notification access” or “Device &amp; app notifications”, then select LyricsBridge.</string>
    <string name="notification_access_originos">On OriginOS, search Settings for “Notification access”. On some models, look in iManager under Behavior information protection → Sensitive information protection.</string>
    <string name="notification_access_coloros">On ColorOS, look in Settings → Apps → Special app access → Notification access. If the menu differs, search Settings for “Notification access”.</string>
    <string name="notification_access_restricted">If Android reports a restricted setting and you trust the APK source, open LyricsBridge’s App info → ⋮ → Allow restricted settings, then try again.</string>
    <string name="xiaomi_battery_policy">Xiaomi battery saver</string>
    <string name="xiaomi_battery_policy_detail">To keep lyrics updating when you switch apps or lock the screen, choose “No restrictions” for LyricsBridge. If App info opens, select “Battery saver” first.</string>
