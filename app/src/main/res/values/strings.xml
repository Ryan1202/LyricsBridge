    <string name="island_lyrics_detail">Show lyrics on Super Island while keeping song titles in Apple Music. System notifications and Bluetooth titles also show lyrics.</string>
    <string name="notification_access">Notification access</string>
    <string name="notification_access_detail">Required for lyric sync. LyricsBridge uses notification access to read the current Apple Music track, playback state, and position so lyrics stay in time.</string>
    <string name="status_notifications">Status notifications</string>
    <string name="status_notifications_detail">Optional. Allows LyricsBridge to show sync status in the notification shade and lets you pause sync from the notification.</string>
