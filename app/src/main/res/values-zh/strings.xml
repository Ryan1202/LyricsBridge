    <string name="notification_access">通知使用权</string>
    <string name="notification_access_detail">同步歌词所需。LyricsBridge 借此读取 Apple Music 当前播放的歌曲、播放状态和进度，让歌词跟上播放。</string>
    <string name="status_notifications">状态通知</string>
    <string name="status_notifications_detail">可选。允许 LyricsBridge 在通知栏显示同步状态，并提供「暂停同步」按钮。</string>
    <string name="permission_guide">权限设置引导</string>
    <string name="notification_access_steps">进入系统页面后，如果看到应用列表，请选择 LyricsBridge，开启通知使用权后返回。</string>
